{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cash video analysis verdict",
  "type": "object",
  "required": ["Status", "Verdict", "violations"],
  "properties": {
    "Status": {"enum": ["completed", "partial", "failed"]},
    "Verdict": {"enum": ["violation_suspected", "no_violation_observed", "insufficient_evidence"]},
    "violations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "timecode", "description", "evidence_frame", "time_interval_seconds", "requires_review"],
        "properties": {
          "type": {"type": "string"},
          "timecode": {"type": "string", "pattern": "^[0-9]{2,}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}$"},
          "description": {"type": "string"},
          "evidence_frame": {"type": ["string", "null"]},
          "evidence_frames": {"type": "array", "items": {"type": "string"}},
          "time_interval_seconds": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": ["number", "null"]}},
          "requires_review": {"const": true}
        }
      }
    }
  }
}
