# Сгенерируйте свой ключ длиной не менее 24 символов.
API_KEY=replace-with-a-long-random-secret-key
PUBLIC_UI_ACCESS=0
MAX_UPLOAD_MB=256
MAX_VIDEO_SECONDS=180
MODEL_TIMEOUT_SECONDS=210
RETENTION_HOURS=24
WORKER_CONCURRENCY=1
# Только локальный просмотр оригинальных ресурсов игры. По умолчанию выключено.
ENABLE_LOCAL_GAME_ASSETS=0
# Коллега реализует model/model_runtime.py с функцией predict(video_path, duration_sec).
MODEL_COMMAND_JSON=["python","-m","app.model_adapter"]

# Встроенный обработчик для одного локального процесса API; Compose использует отдельный worker.
EMBEDDED_WORKER=1
# Включать только после реализации predict и предоставления весов. V13 работает без этой модели.
ENABLE_TEAM_MODEL=0
OKO_DETECTORS=obstruction
OKO_DEADLINE_SEC=300
OKO_RESERVE_SEC=20
OKO_SAMPLE_FPS=5
OKO_THRESHOLD=0.5
OKO_REVIEW_THRESHOLD=0.3
OKO_FACE_BLUR=auto
OKO_MAX_QUEUE=2
SESSION_HOURS=12
# Укажите внешний HTTPS-адрес, если TLS завершается на обратном прокси.
# Например: OKO_PUBLIC_ORIGIN=https://oko.example.org
OKO_PUBLIC_ORIGIN=

# Собственный сервер команды (не Jupyter URL, не сторонний AI API).
ANALYSIS_BACKEND=datathon
DATATHON_API_URL=http://127.0.0.1:8766
# Пустое значение использует API_KEY; ключ не коммитить.
DATATHON_API_KEY=
